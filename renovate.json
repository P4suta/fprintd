{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "Keep the pure-crate MSRV test on Rust 1.82.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/ci.yml"],
      "matchPackageNames": ["rust"],
      "matchCurrentValue": "/^1\\.82(?:\\.\\d+)?$/",
      "allowedVersions": "/^1\\.82(?:\\.\\d+)?$/"
    }
  ]
}
